# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.ruff_cache/
.ipynb_checkpoints/

# --- Virtual environment ---
.venv/
venv/

# --- Secrets (never commit real credentials) ---
.env

# --- Data ---
# Raw NASA files are small and committed as a dated snapshot for reproducibility.
# Processed files are regenerated by scripts/clean_data.py, so they are not tracked.
data/processed/*
!data/processed/.gitkeep

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# Large downloads (re-created by scripts/download_grid.py); the manifest is committed
data/raw/grid/*
!data/raw/grid/manifest.json

# plotly.js written by app/views/home.py for offline use
app/static/
