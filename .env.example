# Copy this file to .env and set your own values. Never commit .env.

# Database owner (used by docker-compose and the loading scripts)
POSTGRES_DB=global_temperature
POSTGRES_USER=gts_admin
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Read-only role used by the web app and the SQL Playground (created by database/roles.sql)
POSTGRES_READER_USER=gts_reader
POSTGRES_READER_PASSWORD=change-me-too
